# 이 호스트가 속한 OpenStack 배포의 컨트롤 플레인에 물어서 팜 소속을 확정한다.
#
# Install: /etc/systemd/system/ 에 이 unit 과 .timer 를 두고
#          systemctl enable --now vctl-openstack-reconcile.timer
# Creds:   /etc/vctl/reconcile-role-id, /etc/vctl/reconcile-secret-id
#          (AppRole -> vctl-reconcile 정책 -> kv/teams/sre/vctl-* + vctl-rw)
#
# # 왜 중앙이 아니라 여기인가
#
# 중앙 CronJob 으로 먼저 만들었고 동작하지 않는다. **각 팜의 Keystone VIP 는 그
# 팜 안에서만 도달한다.** 실측:
#
#                 172.16.0.10   172.16.0.245   172.29.0.100
#   incheon-aio01     OK            FAIL           FAIL
#   sre-srv-0050     FAIL            OK            FAIL
#   sre-srv-0034     FAIL           FAIL            OK
#
# 클러스터 파드·노드·sre-lb(WireGuard 허브) 어디서도 여섯 팜에 닿지 않는다.
# 중앙에서 되던 두 팜은 우연히 클러스터와 같은 망일 뿐이다.
#
# # 자격증명에 대해
#
# node-agent 의 AppRole 을 쓰지 않는다. 그것은 함대 43대가 공유하므로, 거기에
# OpenStack admin 을 읽을 권한을 얹으면 **모든 호스트**가 그 능력을 갖는다.
# 이 unit 은 팜당 컨트롤러 한 대에만 설치되고 별도 AppRole 을 쓴다.
#
# 그 호스트에 자격증명이 새로 생기는 것은 아니다 — nova.conf 와
# admin-openrc.sh 에 이미 평문으로 있다. 달라지는 것은 그것을 읽을 수 있는
# 호스트의 수다.
[Unit]
Description=vctl OpenStack farm membership reconciler
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
Environment=VCTL_AUTH_METHOD=approle
Environment=VCTL_ROLE_ID_FILE=/etc/vctl/reconcile-role-id
Environment=VCTL_SECRET_ID_FILE=/etc/vctl/reconcile-secret-id
Environment=HOME=/var/lib/vctl-reconcile
# node-agent 가 TasksMax 에 걸려 죽은 뒤로 이 값을 명시한다. GOMAXPROCS 가 안
# 묶인 Go 런타임은 유닛이 받는 CPU 가 아니라 호스트의 코어 수에 맞춰 스레드 풀을
# 만든다 — 72코어 기계에서 5개가 아니라 23개를 썼다.
Environment=GOMAXPROCS=2
# --self: 이 호스트가 속한 팜만. unit 에 팜 이름을 박지 않으므로, 호스트가
#         옮겨가거나 VIP 가 바뀌어도 아무도 보지 않는 파일에 낡은 값이 남지 않는다.
# --insecure: 이 팜들의 Keystone 은 IP 에 자체 서명 인증서를 달고 있어 어떤 CA 로도
#         검증할 수 없다. 팜마다 CA 를 심기 전까지 이 플래그가 사실을 그대로 말한다.
ExecStart=/usr/local/bin/vctl-agent openstack reconcile --self --insecure
User=root
StateDirectory=vctl-reconcile
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
ReadOnlyPaths=/etc/vctl
ReadWritePaths=/var/lib/vctl-reconcile
CPUQuota=10%
MemoryHigh=64M
MemoryMax=96M
TasksMax=24
IOWeight=25
Nice=10
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200
